API_PORT=8000
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
USE_XGB=true
JWT_SECRET_KEY=<generate-a-strong-random-string-and-keep-it-secret>
# AI chatbot + news analysis (Gemini). Use a DEDICATED key, separate from the
# Facebook bot's GEMINI_API_KEY (which is already 429-throttled). Unset = the
# chat endpoints return 503 (the rest of the API is unaffected).
CHAT_GEMINI_API_KEY=<google-ai-studio-gemini-api-key>
# Optional: override the model fallback chain (comma-separated, first = preferred).
# Each model has its own daily-request bucket, so the chain aggregates capacity.
# Default: gemini-2.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite (≈540 req/day)
# CHAT_GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite
