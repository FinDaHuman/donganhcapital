# Local backend template.
# Copy to backend/.env, or run from repo root:
#   powershell -ExecutionPolicy Bypass -File .\scripts\setup-local-env.ps1

APP_ENV=local
API_PORT=8000
PORT=8000

# Keep localhost consistent with frontend/.env for browser auth cookies.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Render/Neon usually requires SSL. Use DATABASE_SSLMODE=disable for a local
# Postgres server that does not support SSL.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_SSLMODE=require

# Stable signing key. Generate a long random value and keep it private.
JWT_SECRET_KEY=<generate-a-strong-random-string-and-keep-it-secret>

# Public origin of this API. Used to build unsubscribe links that are clicked
# from a mail client, so it cannot be a relative path.
PUBLIC_API_URL=http://localhost:8000

# Salt for consent-record IP hashes. Deliberately separate from JWT_SECRET_KEY:
# rotating the JWT secret must not invalidate proof of consent. Losing this makes
# existing hashes unverifiable (they are evidence, not lookup keys). Unset = no
# IP metadata is recorded, which is a valid, more private choice.
CONSENT_IP_SALT=<generate-a-strong-random-string-and-keep-it-secret>

# Signs one-click unsubscribe tokens (RFC 8058). Unset disables unsubscribe links.
UNSUBSCRIBE_SECRET=<generate-a-strong-random-string-and-keep-it-secret>

# Local HTTP cookies. Production defaults are secure cookies scoped to
# .donganhcapital.com when APP_ENV is omitted or set to production.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

USE_XGB=true

# Google OAuth. The localhost redirect URI must also be allowed in Google Cloud.
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Transactional email via Resend. Unset RESEND_API_KEY makes email no-op locally.
RESEND_API_KEY=
EMAIL_FROM=DongAnh Capital <noreply@donganhcapital.com>
SUPPORT_EMAIL=support@donganhcapital.com

# SePay / VietQR subscriptions.
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ID=MB
SEPAY_BANK_ACCOUNT_NO=
SEPAY_BANK_ACCOUNT_NAME=DONG ANH CAPITAL

# MongoDB-backed CafeF news feed. Unset disables news endpoints gracefully.
MONGODB_URI=

# AI chatbot + news analysis. Use a dedicated Gemini key.
CHAT_GEMINI_API_KEY=
# CHAT_GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite
